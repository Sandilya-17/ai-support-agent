ANTHROPIC_API_KEY=your_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5

# Human-in-the-loop: ticket creation waits for approval unless set to "false".
REQUIRE_TICKET_APPROVAL=true
# Required to use the /approvals endpoints (they stay disabled if unset).
ADMIN_API_KEY=change-me-to-a-long-random-string

LOG_LEVEL=INFO
# Never enable in production (exposes the Werkzeug debugger).
FLASK_DEBUG=false
